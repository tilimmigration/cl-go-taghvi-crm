# Copy this file to .env.local (gitignored) and fill in the real values
# from your Supabase project: Project Settings -> API.
#
# Both values below are SAFE to expose in the browser bundle — Supabase's
# publishable/anon key is a public identifier, not a secret, and access is
# controlled by Row Level Security policies on the database, not by
# keeping this key hidden.
#
# NEVER put the Supabase service_role / secret key in a VITE_* variable —
# anything prefixed VITE_ is inlined into the client-side JS bundle and
# shipped to every visitor's browser. The service role key belongs only
# in Supabase Edge Function secrets (see supabase/functions/monday-webhook).

VITE_SUPABASE_URL=https://qaeeqpwloptzazqmcrxi.supabase.co

# Newer Supabase projects issue a "publishable" key (starts with sb_publishable_...).
# If your project only has a legacy "anon" key instead, put it here — either
# name works, the app checks both.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_uISOpSzFsaI-BhoKtNZ8GA_v2UXWz15
